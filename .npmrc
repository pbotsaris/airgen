; The workspace runs one React runtime (19) for all tests, but the stable
; @airtable/blocks SDK peers on react ^16.14 || ^17 and @types/react-dom@17
; (the react17 typecheck leg) peers on @types/react@17. Both conflicts are
; compile/typecheck-time only — never runtime pairings — so peer resolution
; is relaxed instead of nesting duplicate React copies.
legacy-peer-deps=true
