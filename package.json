{
  "name": "airgen",
  "version": "0.4.2",
  "description": "Reactive TypeScript type generator for Airtable Custom Extensions: watches the base schema from inside the extension and writes airtable-schema.ts to disk via a local daemon.",
  "license": "MIT",
  "author": "Pedro Botsaris <pedro@antfood.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbotsaris/airgen.git"
  },
  "homepage": "https://github.com/pbotsaris/airgen#readme",
  "bugs": {
    "url": "https://github.com/pbotsaris/airgen/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "airgen": "bin/airgen.js"
  },
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./interface": {
      "types": "./dist/client/interface.d.ts",
      "default": "./dist/client/interface.js"
    },
    "./base": {
      "types": "./dist/client/base.d.ts",
      "default": "./dist/client/base.js"
    },
    "./generator": {
      "types": "./dist/client/generator.d.ts",
      "default": "./dist/client/generator.js"
    },
    "./daemon": "./src/daemon/server.js"
  },
  "files": [
    "bin",
    "dist",
    "src/daemon",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/*.test.js",
    "test:ui": "npm test --workspace @airgen/ui",
    "test:all": "npm test && npm run test:ui",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "airtable",
    "blocks",
    "extension",
    "typescript",
    "codegen"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@airtable/blocks": ">=1.10.0 || >=0.0.0-0",
    "react": ">=16.14"
  },
  "devDependencies": {
    "@airtable/blocks": "^1.19.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2"
  }
}
