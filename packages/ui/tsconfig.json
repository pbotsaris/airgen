{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    // The repo root hoists airgen's @types/react@17; pin this package (and
    // every dependency's `react` type reference, e.g. lucide-react's) to the
    // local v19 types. tsconfig.react17.json overrides these for the
    // React 17 compatibility leg.
    "paths": {
      "react": ["./node_modules/@types/react", "../../node_modules/@types/react"],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime",
        "../../node_modules/@types/react/jsx-runtime"
      ],
      "react-dom": ["./node_modules/@types/react-dom", "../../node_modules/@types/react-dom"]
    }
  },
  "include": ["src"]
}
